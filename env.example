# ============================================================
# CSA AI Chatbot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env with real keys to version control.
# ============================================================

# --- OpenAI ---
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# --- Pinecone ---
# Get your key at https://app.pinecone.io/
# Free tier: 1 index, up to 100K vectors (sufficient for CSA docs)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE

# Index name you created in Pinecone console:
#   dimension: 1536  (matches text-embedding-3-small)
#   metric:    cosine
PINECONE_INDEX_NAME=csa-chatbot

# --- App Settings (optional overrides; values shown are the defaults) ---
# TOP_K=5                # chunks returned when reranking is off
# CHUNK_SIZE=500         # tokens per chunk at ingest time
# CHUNK_OVERLAP=50
# API_HOST=0.0.0.0
# API_PORT=8000

# --- Retrieval / reranking (optional overrides) ---
# RERANK_ENABLED=true    # set to false to skip GPT reranking entirely
# RERANK_TOP_K=12        # candidates fetched from Pinecone before reranking
# FINAL_TOP_K=6          # chunks kept in the prompt context after reranking

# --- Reporting endpoints ---
# Protects /api/analytics/* and /api/feedback/stats, which otherwise expose what
# visitors ask CSA to anyone who knows the path. Send it as the header
# X-Analytics-Token. If unset the endpoints stay open and the app logs a warning.
# ANALYTICS_TOKEN=scegli-una-stringa-lunga-e-casuale

# --- Avatar POC ---
# Get it from the Simli dashboard: https://app.simli.com/
SIMLI_API_KEY=YOUR_SIMLI_API_KEY_HERE
