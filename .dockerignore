# Sensitive data — never bake into image
.env
*.env.local
*.env.*.local

# PDFs (already vectorised in Pinecone — not needed at runtime).
# api/model_registry.json and api/site_structure.json are derived from these and
# DO ship, because retrieval reads them at query time.
docs/
xlc engeniering/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Version control
.git
.gitignore

# Tests (not needed at runtime)
tests/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
